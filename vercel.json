{
  "trailingSlash": true,
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "brunch.freefrom365.com"
        }
      ],
      "dest": "/breakfast/"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "brunch.freefrom365.com"
        }
      ],
      "dest": "/breakfast/$1"
    },
