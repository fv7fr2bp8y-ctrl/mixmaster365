{
  "trailingSlash": true,
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "host", "value": "brunch.freefrom365.com" }],
      "dest": "/breakfast/"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "brunch.freefrom365.com" }],
      "dest": "/breakfast/$1"
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "breakfast.freefrom365.com" }],
      "status": 307,
      "headers": { "Location": "/breakfast/" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "healthy-gut.freefrom365.com" }],
      "dest": "/free-from/"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "healthy-gut.freefrom365.com" }],
      "dest": "/free-from/$1"
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "gluten-free.freefrom365.com" }],
      "status": 307,
      "headers": { "Location": "/gluten-free/" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "dairy-free.freefrom365.com" }],
      "status": 307,
      "headers": { "Location": "/dairy-free/" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "meat-free.freefrom365.com" }],
      "status": 307,
      "headers": { "Location": "/meat-free/" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "plant-based.freefrom365.com" }],
      "status": 307,
      "headers": { "Location": "/plant-based/" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "freefrom365.com" }],
      "status": 307,
      "headers": { "Location": "https://healthy-gut.freefrom365.com/free-from/" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "www.freefrom365.com" }],
      "status": 307,
      "headers": { "Location": "https://healthy-gut.freefrom365.com/free-from/" }
    },
    { "handle": "filesystem" }
  ]
}
